generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SUBSYSTEM_ADMIN
  USER
}

model Subsystem {
  id          String          @id @default(cuid())
  key         String          @unique
  title       String
  description String?
  enabled     Boolean         @default(true)
  sortOrder   Int             @default(0)
  dependencies Json?
  memberships UserSubsystem[]
  adminScopes SubsystemAdminScope[]
  groups      Group[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String
  passwordHash        String
  role                UserRole        @default(USER)
  active              Boolean         @default(true)
  subsystemMemberships UserSubsystem[]
  adminScopes         SubsystemAdminScope[]
  groupMemberships    UserGroup[]
  hrProfile           HrEmployee?
  companyMemberships  CompanyMember[]
  // The person's own signature, as a transparent PNG data URL. One per person,
  // reused wherever a paper needs it: a حکم, a صورت‌جلسه. It is drawn or
  // uploaded once and never typed, because a signature is a mark, not a font.
  signatureImage      String?         @db.Text
  signatureAt         DateTime?
  // A signature captured on a minute is snapshotted next to the paper, so a
  // later change of signature cannot rewrite a document that was already signed.
  minuteSignatures    HrMinuteSignature[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model UserSubsystem {
  userId      String
  subsystemId String
  enabled     Boolean   @default(true)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subsystem   Subsystem @relation(fields: [subsystemId], references: [id], onDelete: Cascade)
  @@id([userId, subsystemId])
}

model SubsystemAdminScope {
  userId      String
  subsystemId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subsystem   Subsystem @relation(fields: [subsystemId], references: [id], onDelete: Cascade)
  @@id([userId, subsystemId])
}

model Group {
  id          String           @id @default(cuid())
  name        String
  subsystemId String?
  subsystem   Subsystem?       @relation(fields: [subsystemId], references: [id], onDelete: Cascade)
  members     UserGroup[]
  permissions GroupPermission[]
  createdAt   DateTime         @default(now())
  @@unique([name, subsystemId])
}

model UserGroup {
  userId  String
  groupId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  @@id([userId, groupId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  title       String
  groups      GroupPermission[]
}

model GroupPermission {
  groupId      String
  permissionId String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([groupId, permissionId])
}

enum CoreRequestKind {
  GENERAL
  ACCESS
  SERVICE
  IDEA
}

enum CoreRequestStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model CoreRequest {
  id           String            @id @default(cuid())
  number       Int               @unique @default(autoincrement())
  kind         CoreRequestKind
  title        String
  description  String
  priority     String            @default("NORMAL")
  status       CoreRequestStatus @default(OPEN)
  ownerId      String
  ownerName    String
  response     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  events       CoreRequestEvent[]
  votes        CoreIdeaVote[]

  @@index([ownerId, createdAt])
  @@index([kind, status, createdAt])
}

model CoreRequestEvent {
  id           String            @id @default(cuid())
  requestId    String
  request      CoreRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId      String
  actorName    String
  status       CoreRequestStatus
  note         String?
  createdAt    DateTime          @default(now())

  @@index([requestId, createdAt])
}

model CoreNotification {
  id           String   @id @default(cuid())
  recipientId  String
  title        String
  body         String
  requestId    String?
  readAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
}

model CoreAnnouncement {
  id           String   @id @default(cuid())
  title        String
  body         String
  authorId     String
  authorName   String
  important    Boolean  @default(false)
  archivedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([archivedAt, createdAt])
}

model CoreIdeaVote {
  requestId    String
  userId       String
  request      CoreRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([requestId, userId])
}

model HrEmployee {
  id            String   @id @default(cuid())
  personnelCode String   @unique
  name          String
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Tenant of the personnel file. Nullable so legacy rows survive an upgrade;
  // `npm run backfill:hr-company` fills it from the user's company membership.
  // The person's seat is not copied here: it is resolved through CompanyMember
  // and PositionAssignment, so the chart stays the single source of truth.
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  department    String
  jobTitle      String
  worksite      String
  managerId     String?
  manager       HrEmployee? @relation("HrTeam", fields: [managerId], references: [id], onDelete: SetNull)
  team          HrEmployee[] @relation("HrTeam")
  startDate     DateTime @db.Date
  contractType  String   @default("FULL_TIME")
  phone         String   @default("")
  education     String   @default("")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  requests      HrRequest[]
  attendance    HrAttendance[]
  shifts        HrShift[]
  evaluations   HrEvaluation[]
  transfers     HrTransfer[]
  // کارگزینی: the personnel file's legal papers.
  contracts     HrContract[]
  decrees       HrDecree[]
  documents     HrDocument[]
  // Facts the pessimistic file audit reads. They live on the file, not on the
  // contract, because they describe the person, not one engagement.
  nationalId      String    @default("")
  birthDate       DateTime? @db.Date
  militaryStatus  String    @default("NOT_SUBJECT")
  veteranStatus   String    @default("NONE")
  veteranVerified Boolean   @default(false)
  employmentState String    @default("ACTIVE")
  stateSince      DateTime? @db.Date
  // The identity block a حکم prints: the facts an organization keeps about the
  // person's degree, seat and service, which are the same categories everywhere
  // and different labels in each institution.
  hokmProfile   HrHokmProfile?
  meetingSeats  HrMeetingMember[]
  minuteAttendance HrMinuteAttendee[]
  ownedResolutions HrMinuteResolution[]
  responses     HrSurveyResponse[]
  feedback      HrFeedback[]
  acknowledgements HrAcknowledgement[]
  features      HrEmployeeFeature[]
  talent        HrTalentReview?
  @@index([managerId, active])
  @@index([department, active])
  @@index([companyId, active])
}

model HrRequest {
  id          String   @id @default(cuid())
  number      Int      @unique @default(autoincrement())
  employeeId  String
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind        String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  minutes     Int?
  description String
  status      String   @default("PENDING")
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      HrRequestEvent[]
  @@index([employeeId, status, createdAt])
}

model HrRequestEvent {
  id          String @id @default(cuid())
  requestId   String
  request     HrRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId     String
  actorName   String
  status      String
  note        String?
  createdAt   DateTime @default(now())
  @@index([requestId, createdAt])
}

model HrAttendance {
  id           String @id @default(cuid())
  employeeId   String
  employee     HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workDate     DateTime @db.Date
  status       String
  clockIn      String?
  clockOut     String?
  endNextDay   Boolean @default(false)
  breakMinutes Int @default(0)
  workedMinutes Int @default(0)
  note         String @default("")
  recordedBy   String
  updatedAt    DateTime @updatedAt
  @@unique([employeeId, workDate])
}

model HrShift {
  id          String @id @default(cuid())
  employeeId  String
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workDate    DateTime @db.Date
  kind        String
  startTime   String?
  endTime     String?
  endNextDay  Boolean @default(false)
  note        String @default("")
  published   Boolean @default(false)
  updatedAt   DateTime @updatedAt
  @@unique([employeeId, workDate])
}

model HrEvaluation {
  id              String @id @default(cuid())
  employeeId      String
  employee        HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  period          String
  scores          Json
  summary         String
  developmentPlan String @default("")
  status          String @default("DRAFT")
  authorId        String
  authorName      String
  publishedBy     String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([employeeId, period])
}

model HrJob {
  id          String @id @default(cuid())
  title       String
  department  String
  worksite    String
  description String
  openings    Int @default(1)
  status      String @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  candidates  HrCandidate[]
}

model HrCandidate {
  id              String @id @default(cuid())
  jobId           String
  job             HrJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  name            String
  email           String
  phone           String @default("")
  education       String @default("")
  experienceYears Int @default(0)
  notes           String @default("")
  stage           String @default("APPLIED")
  decisionNote    String?
  decidedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([jobId, email])
}

model HrTransfer {
  id             String @id @default(cuid())
  employeeId     String
  employee       HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fromDepartment String
  fromJobTitle   String
  fromWorksite   String
  toDepartment   String
  toJobTitle     String
  toWorksite     String
  effectiveDate  DateTime @db.Date
  reason         String
  status         String @default("PENDING")
  proposedBy     String
  proposedByName String
  decisionNote   String?
  decidedBy      String?
  appliedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([employeeId, status])
}

// کارگزینی: قرارداد. One row per engagement, kept after it ends — the file is a
// ledger, not a single current value. `HrEmployee.contractType` stays what it
// always was (full-time / part-time / temporary): the *arrangement*, a different
// axis from the contract kind (دائم / پیمانی / یک‌ساله / …).
model HrContract {
  id         String @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeId String
  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // PERMANENT | PAYMANI | ANNUAL | FIXED_TERM | PROBATION | PROJECT | CONTRACTOR
  kind       String
  startDate  DateTime  @db.Date
  // Null means "no end date" (دائم, پروژه‌ای open-ended).
  endDate    DateTime? @db.Date
  // ACTIVE | ENDED | TERMINATED
  status     String   @default("ACTIVE")
  baseSalary Int      @default(0) // Rial
  renewals   Int      @default(0)
  // Only for CONTRACTOR contracts: the contractor company whose crew this is.
  contractorCompanyId String?
  contractorCompany   HrContractorCompany? @relation(fields: [contractorCompanyId], references: [id], onDelete: SetNull)
  note       String   @default("")
  closedAt   DateTime?
  closedReason String @default("")
  createdById   String?
  createdByName String @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  decrees    HrDecree[]
  @@index([companyId, status, endDate])
  @@index([employeeId, status])
}

// حکم: the signed paper behind a change in the personnel file. `notifiedAt` is
// the moment the person was actually told; the audit chases decrees that were
// issued and never notified.
model HrDecree {
  id          String @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contractId  String?
  contract    HrContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  number      String // e.g. ح-۱۴۰۵-۱۱۰۰, unique inside the company
  kind        String // APPOINTMENT | SALARY_INCREASE | ...
  status      String @default("ISSUED") // ISSUED | CANCELLED
  issuedAt    DateTime @default(now())
  effectiveAt DateTime @db.Date
  notifiedAt  DateTime?
  signer      String @default("")
  cosigner    String @default("")
  baseSalary  Int    @default(0)
  reason      String @default("")
  // The organization's layout this حکم was issued on. Kept by id *and* by the
  // rows it produced: a template edited later must not restyle a paper that was
  // already signed, so `items` below are the copy that is printed.
  templateId   String?
  template     HrDecreeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  signerTitle  String @default("")
  // Whose signature image the print page shows, if the signer has one.
  signerUserId String?
  items        HrDecreeItem[]
  createdById   String?
  createdByName String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([companyId, number])
  @@index([companyId, status, issuedAt])
  @@index([employeeId, issuedAt])
}

// مدارک پرونده: the ten mandatory documents, one row per person and kind. A row
// that does not exist is "missing" as far as the audit is concerned, which keeps
// the table small and makes the checklist idempotent.
model HrDocument {
  id         String @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeId String
  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       String
  status     String @default("MISSING") // PRESENT | MISSING
  reference  String @default("") // serial number, archive file number, …
  verifiedAt DateTime?
  note       String @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([employeeId, kind])
  @@index([companyId, status])
}

// شرکت پیمانکار: a supplier company whose crew works on our site. Its own
// contract expiry is the one date a dozen personnel files inherit.
model HrContractorCompany {
  id         String @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name       String
  contractNo String @default("")
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  active     Boolean @default(true)
  note       String @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  contracts  HrContract[]
  @@unique([companyId, name])
  @@index([companyId, active])
}

// قالب حکم: the layout and the item catalogue an organization issues its decrees
// on. "Its items are different in each organization" is the whole reason this is
// a table and not a constant: the same code prints a university's salary items
// and a factory's, because the list is data.
model HrDecreeTemplate {
  id           String @id @default(cuid())
  companyId    String
  company      Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name         String // «حکم اعضای هیات علمی رسمی»
  title        String @default("حکم کارگزینی")
  ministryLine String @default("") // the line at the top right of the paper
  unitLine     String @default("") // the institution's own name
  intro        String @default("") // default شرح حکم
  footer       String @default("") // the standing paragraph above the signature
  active       Boolean @default(true)
  items        HrDecreeItemRule[]
  decrees      HrDecree[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([companyId, name])
  @@index([companyId, active])
}

// One line of the item catalogue: «حقوق و مرتبه و پایه», «حق اولاد», …
model HrDecreeItemRule {
  id            String @id @default(cuid())
  templateId    String
  template      HrDecreeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key           String // stable code, e.g. BASE, CHILD, HOUSING
  label         String
  kind          String @default("EARNING") // EARNING | DEDUCTION
  required      Boolean @default(false)
  defaultAmount Int @default(0)
  note          String @default("")
  sortOrder     Int @default(0)
  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

// The amounts printed on one حکم. Copied from the catalogue at issue time and
// frozen afterwards, so editing the template does not rewrite a signed paper.
model HrDecreeItem {
  id        String @id @default(cuid())
  decreeId  String
  decree    HrDecree @relation(fields: [decreeId], references: [id], onDelete: Cascade)
  key       String
  label     String
  letter    String @default("") // الف، ب، پ …
  kind      String @default("EARNING")
  amount    Int    @default(0)
  note      String @default("")
  sortOrder Int    @default(0)
  @@unique([decreeId, key])
  @@index([decreeId, sortOrder])
}

// مشخصات حکم: the identity block fields 1–19 of the paper. They are kept apart
// from `HrEmployee` because they describe the document, not the employment, and
// because every organization fills them differently.
model HrHokmProfile {
  id               String @id @default(cuid())
  employeeId       String @unique
  employee         HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fatherName       String @default("")
  idBookNo         String @default("") // شماره شناسنامه
  birthPlace       String @default("")
  birthProvince    String @default("")
  degree           String @default("") // آخرین مدرک تحصیلی
  major            String @default("")
  orientation      String @default("") // گرایش
  university       String @default("")
  country          String @default("")
  degreeDate       DateTime? @db.Date
  orgPosition      String @default("") // پست سازمانی
  positionNo       String @default("")
  positionUniqueId String @default("") // شناسه یکتای پست
  employmentStatus String @default("") // وضعیت استخدامی: رسمی قطعی …
  employmentCase   String @default("شاغل")
  serviceYears     Int @default(0)
  serviceMonths    Int @default(0)
  serviceDays      Int @default(0)
  maritalStatus    String @default("")
  children         Int @default(0)
  rank             String @default("") // مرتبه علمی / گروه شغلی
  basePoint        Int @default(0) // پایه استحقاقی
  veteranPoint     Int @default(0) // ایثارگری
  licenseNo        String @default("") // مجوز شماره
  licenseDate      DateTime? @db.Date
  executivePosition String @default("") // پست اجرایی
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// جلسه: a standing body with a roster — «شورای دانشگاه», «شورای دانشکده».
model HrMeeting {
  id            String @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name          String
  period        String @default("") // روزانه | هفتگی | ماهیانه | غیرمشخص
  active        Boolean @default(true)
  createdById   String?
  createdByName String @default("")
  members       HrMeetingMember[]
  minutes       HrMeetingMinute[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([companyId, active])
}

// عضویت: who sits on it, and who writes for it. Only an active member's minute
// asks them for a signature.
model HrMeetingMember {
  id         String @id @default(cuid())
  meetingId  String
  meeting    HrMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  employeeId String
  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role       String @default("MEMBER") // MEMBER | SECRETARY
  active     Boolean @default(true)
  createdAt  DateTime @default(now())
  @@unique([meetingId, employeeId])
  @@index([employeeId, active])
}

// صورت‌جلسه: the paper. DRAFT is written, FOR_SIGNATURE is frozen and out for
// signature, SIGNED is complete, CANCELLED is kept as history.
model HrMeetingMinute {
  id            String @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  meetingId     String
  meeting       HrMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  number        String
  date          DateTime @db.Date
  time          String @default("")
  location      String @default("")
  status        String @default("DRAFT")
  summary       String @default("")
  createdById   String?
  createdByName String @default("")
  attendees     HrMinuteAttendee[]
  resolutions   HrMinuteResolution[]
  signatures    HrMinuteSignature[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([companyId, number])
  @@index([companyId, status, date])
}

// The attendance list as it stood on the day: present is what the signature
// quorum counts, so somebody absent is not chased for a signature.
model HrMinuteAttendee {
  id         String @id @default(cuid())
  minuteId   String
  minute     HrMeetingMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  employeeId String
  employee   HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  present    Boolean @default(true)
  @@unique([minuteId, employeeId])
}

// مصوبه: one numbered decision. `result` is the vote, `owner` the person who has
// to carry it out.
model HrMinuteResolution {
  id         String @id @default(cuid())
  minuteId   String
  minute     HrMeetingMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  itemNo     String
  text       String
  result     Boolean @default(true)
  ownerId    String?
  owner      HrEmployee? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate    DateTime? @db.Date
  sortOrder  Int @default(0)
  @@index([minuteId, sortOrder])
  @@index([ownerId])
}

// امضای صورت‌جلسه: the image as it was when the member signed. It is a snapshot,
// not a pointer, because the paper must keep the mark that was put on it.
model HrMinuteSignature {
  id         String @id @default(cuid())
  minuteId   String
  minute     HrMeetingMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String
  signerName String
  signerTitle String @default("")
  image      String @db.Text
  signedAt   DateTime @default(now())
  @@unique([minuteId, userId])
  @@index([userId, signedAt])
}

model HrSurvey {
  id          String @id @default(cuid())
  title       String
  description String
  questions   Json
  department  String?
  status      String @default("DRAFT")
  dueDate     DateTime? @db.Date
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  responses   HrSurveyResponse[]
}

model HrSurveyResponse {
  id          String @id @default(cuid())
  surveyId    String
  survey      HrSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  answers     Json
  submittedAt DateTime @default(now())
  @@unique([surveyId, employeeId])
}

model HrFeedback {
  id          String @id @default(cuid())
  employeeId  String
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind        String
  message     String
  anonymous   Boolean @default(false)
  status      String @default("NEW")
  response    String?
  respondedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HrRegulation {
  id          String @id @default(cuid())
  title       String
  category    String
  body        String
  version     String
  sourceUrl   String?
  published   Boolean @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  acknowledgements HrAcknowledgement[]
}

model HrAcknowledgement {
  regulationId String
  regulation   HrRegulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  readAt       DateTime @default(now())
  @@id([regulationId, employeeId])
}

model HrNotification {
  id          String @id @default(cuid())
  recipientId String
  title       String
  body        String
  view        String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  @@index([recipientId, readAt, createdAt])
}

// بانک ویژگی‌های فردی: هر ردیف یک شاخص پایش‌شده برای یک نیرو (۰ تا ۱۰۰).
model HrEmployeeFeature {
  id            String   @id @default(cuid())
  employeeId    String
  employee      HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category      String
  item          String
  value         Int
  previousValue Int?
  note          String   @default("")
  recordedBy    String
  updatedAt     DateTime @updatedAt
  @@unique([employeeId, category, item])
  @@index([category, item])
}

// نقشه استعداد: عملکرد × پتانسیل، آمادگی ارتقا و مسیر شغلی پیشنهادی.
model HrTalentReview {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  employee    HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  performance Int      @default(60)
  potential   Int      @default(1)
  promoReady  Boolean  @default(false)
  targetRole  String   @default("")
  status      String   @default("OPEN")
  careerPath  Json     @default("[]")
  notes       String   @default("")
  updatedBy   String
  updatedAt   DateTime @updatedAt
  @@index([status])
}

// اهداف و نتایج کلیدی (OKR) سازمانی برای پایش بهره‌وری.
model HrOkr {
  id         String   @id @default(cuid())
  owner      String
  objective  String
  keyResult  String
  progress   Int      @default(0)
  period     String
  status     String   @default("ACTIVE")
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([period, status])
}

// سناریوی چیدمان شیفت سه‌ماهه با معیارهای مالی و ریسک نیروی انسانی.
model HrShiftPlan {
  id         String   @id @default(cuid())
  period     String   @unique
  scenario   String
  status     String   @default("DRAFT")
  metrics    Json
  approvedBy String?
  approvedAt DateTime?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([status])
}

// Company workspaces are isolated from the legacy, installation-wide HR records.
model Company {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  active      Boolean @default(true)
  settings    Json
  revision    Int @default(1)
  members     CompanyMember[]
  roles       CompanyRole[]
  forms       BuilderForm[]
  workflows   BuilderWorkflow[]
  instances   WorkflowInstance[]
  notices     WorkflowNotice[]
  audits      CompanyAudit[]
  departments Department[]
  positions   Position[]
  positionAssignments PositionAssignment[]
  employees   HrEmployee[]
  hrContracts   HrContract[]
  hrDecrees     HrDecree[]
  hrDocuments   HrDocument[]
  hrContractors HrContractorCompany[]
  hrDecreeTemplates HrDecreeTemplate[]
  hrMeetings    HrMeeting[]
  hrMinutes     HrMeetingMinute[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Organizational unit (واحد سازمانی). Company-scoped, so each tenant keeps its own chart.
model Department {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String
  code        String // e.g. "ENG", "HR", "FIN"
  description String?
  isActive    Boolean      @default(true)

  parentId    String?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentHierarchy")

  positions   Position[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([companyId, code])
  @@index([companyId, parentId])
}

enum PositionStatus {
  ACTIVE
  FROZEN
  DISCONTINUED
}

// Job slot (پست سازمانی). Reporting lines connect positions, never people, so a
// vacancy or transfer does not break the chart.
model Position {
  id                  String               @id @default(cuid())
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code                String // e.g. "POS-ENG-001"
  title               String // e.g. "Lead Frontend Engineer"
  description         String?
  jobLevel            Int? // 1 (junior) … 8 (VP)
  status              PositionStatus       @default(ACTIVE)

  departmentId        String
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  reportsToPositionId String?
  reportsTo           Position?            @relation("PositionReportingHierarchy", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  directReports       Position[]           @relation("PositionReportingHierarchy")

  defaultRoleId       String?
  defaultRole         CompanyRole?         @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)

  assignments         PositionAssignment[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([companyId, code])
  @@index([companyId, departmentId])
  @@index([companyId, reportsToPositionId])
}

enum AssignmentType {
  PERMANENT
  TEMPORARY
  ACTING // سرپرست / کفیل
  CONTRACT
}

// Placement of a member in a position (انتساب). Effective dates preserve tenure
// history; only active primary assignments drive approval routing.
model PositionAssignment {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  memberId       String
  member         CompanyMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  positionId     String
  position       Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)

  assignmentType AssignmentType @default(PERMANENT)
  isPrimary      Boolean        @default(true)

  startDate      DateTime       @default(now())
  endDate        DateTime?
  isActive       Boolean        @default(true)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId, memberId, isActive, isPrimary])
  @@index([companyId, positionId, isActive])
}

model CompanyMember {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  active    Boolean @default(true)
  // Cached direct manager, derived from the member's primary position.
  // Retained so worker code and older records keep resolving during migration.
  managerId String?
  roles     CompanyMemberRole[]
  positionAssignments PositionAssignment[]
  createdAt DateTime @default(now())
  @@unique([companyId, userId])
  @@index([companyId, active])
}

model CompanyRole {
  id          String @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String
  permissions Json
  members     CompanyMemberRole[]
  positions   Position[]
  createdAt   DateTime @default(now())
  @@unique([companyId, name])
}

model CompanyMemberRole {
  memberId String
  member   CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId   String
  role     CompanyRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([memberId, roleId])
}

model BuilderForm {
  id          String @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code        String
  title       String
  description String @default("")
  category    String @default("core")
  schema      Json
  submitRoleIds Json
  archived    Boolean @default(false)
  revision    Int @default(1)
  workflow    BuilderWorkflow?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([companyId, code])
  @@index([companyId, category])
}

model BuilderWorkflow {
  id               String @id @default(cuid())
  companyId        String
  company          Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  formId           String @unique
  form             BuilderForm @relation(fields: [formId], references: [id], onDelete: Restrict)
  name             String
  config           Json
  revision         Int @default(1)
  publishedVersion Int?
  versions         WorkflowVersion[]
  updatedAt        DateTime @updatedAt
  @@index([companyId])
}

model WorkflowVersion {
  id          String @id @default(cuid())
  workflowId  String
  workflow    BuilderWorkflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  version     Int
  config      Json
  formSchema  Json
  formTitle   String
  formCode    String
  publishedBy String
  createdAt   DateTime @default(now())
  instances   WorkflowInstance[]
  @@unique([workflowId, version])
}

model WorkflowInstance {
  id            String @id @default(cuid())
  number        Int @unique @default(autoincrement())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  versionId     String
  version       WorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  title         String
  category      String
  submittedBy   String
  submitterName String
  payload       Json
  parameters    Json
  priority      String @default("normal")
  status        String @default("running")
  currentNodeId String?
  returnNodeId  String?
  revision      Int @default(1)
  round         Int @default(0)
  tasks         WorkflowTask[]
  actions       WorkflowAction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?
  @@index([companyId, submittedBy, createdAt])
  @@index([companyId, status])
}

model WorkflowTask {
  id         String @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  nodeId     String
  label      String
  round      Int
  assignedTo String
  status     String @default("pending")
  dueAt      DateTime
  createdAt  DateTime @default(now())
  completedAt DateTime?
  @@unique([instanceId, round, assignedTo])
  @@index([assignedTo, status, dueAt])
}

model WorkflowAction {
  id         String @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  nodeId     String
  nodeLabel  String
  actorId    String
  actorName  String
  action     String
  comment    String @default("")
  createdAt  DateTime @default(now())
  @@index([instanceId, createdAt])
}

model WorkflowNotice {
  id          String @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recipientId String
  instanceId  String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  @@index([companyId, recipientId, readAt])
}

model CompanyAudit {
  id         String @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorId    String
  actorName  String
  action     String
  target     String
  detail     String
  createdAt  DateTime @default(now())
  @@index([companyId, createdAt])
}
