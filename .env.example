DATABASE_URL="postgresql://user:password@localhost:5432/itfco"
AUTH_SECRET="replace-with-a-long-random-secret"
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="change-this-password"
SUPER_ADMIN_NAME="Super Admin"

# پل شیفت‌یار — نشانی سرویس و توکن یکپارچه‌سازی (خروجی scripts/create-integration-token.ts در مخزن شیفت‌یار).
# توکن فقط روی سرور نگه داشته می‌شود؛ به هیچ عنوان در مخزن یا فایل نسخه‌بندی‌شده ذخیره نشود.
SHIFTWISE_BASE_URL="http://localhost:3000"
SHIFTWISE_TOKEN=""

# لایهٔ مدل زبانی — کلید فقط سمت سرور خوانده می‌شود و هرگز به مرورگر نمی‌رود.
# بدون این کلید سامانه در حالت «بدون مدل» کار می‌کند: دستیار از پیکرهٔ دانش
# پاسخ می‌دهد و دکمه‌های پیش‌نویس پیام «مدل تنظیم نشده» می‌دهند.
DEEPSEEK_API_KEY=""
# آدرس سرویس سازگار با OpenAI. برای مدل محلی یا میزبان درون‌کشوری عوض کنید.
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_TIMEOUT_MS="30000"
# AI_DISABLED=1 مدل را حتی با کلید موجود کنار می‌گذارد.
AI_DISABLED=""
# Optional server-side connectors; formats are documented in docs/ATTENDANCE-PAYROLL-ACCOUNTING.md.
ATTENDANCE_REST_SOURCES=""
ATTENDANCE_SYNC_DISABLED=""
ACCOUNTING_INTAKE_TOKENS=""
